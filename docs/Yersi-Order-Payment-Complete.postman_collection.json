{
	"info": {
		"_postman_id": "yersi-order-payment-complete-2025",
		"name": "Yersi Order & Payment Complete API",
		"description": "Complete API documentation for Yersi laundry service with vendor pricing, order confirmation, checkout flow, and payment method management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "📋 Order Management",
			"item": [
				{
					"name": "Calculate Order Pricing",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"serviceId\": \"507f1f77bcf86cd799439020\",\n  \"vendorId\": \"507f1f77bcf86cd799439011\",\n  \"items\": [\n    {\n      \"itemId\": \"shirt001\",\n      \"name\": \"Cotton Shirt\",\n      \"category\": \"Shirts\",\n      \"categoryId\": \"cat001\",\n      \"quantity\": 2,\n      \"weight\": 0.5\n    }\n  ],\n  \"promoCode\": \"SAVE10\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/calculate",
							"host": ["{{base_url}}"],
							"path": ["orders", "calculate"]
						},
						"description": "Calculate order pricing with vendor-specific rates and detailed breakdown"
					},
					"response": [
						{
							"name": "Success with Vendor Pricing",
							"status": "Created",
							"code": 201,
							"body": "{\n  \"totalWeight\": 1.0,\n  \"totalItems\": 2,\n  \"subtotal\": 20.00,\n  \"deliveryFee\": 8.00,\n  \"promoDiscount\": 5.00,\n  \"estimatedMinTotal\": 18.40,\n  \"estimatedMaxTotal\": 27.60,\n  \"currency\": \"GHS\",\n  \"minimumOrderMet\": true,\n  \"vendorPricing\": {\n    \"vendor\": {\n      \"id\": \"507f1f77bcf86cd799439011\",\n      \"name\": \"Quick Wash\",\n      \"deliveryFee\": 8.00\n    },\n    \"itemBreakdown\": [\n      {\n        \"itemId\": \"shirt001\",\n        \"name\": \"Cotton Shirt\",\n        \"basePrice\": 25.00,\n        \"vendorPrice\": 20.00,\n        \"quantity\": 2,\n        \"weight\": 0.5,\n        \"itemTotal\": 20.00,\n        \"savings\": 5.00\n      }\n    ],\n    \"comparedToBase\": 2.00\n  }\n}"
						}
					]
				},
				{
					"name": "Create Draft Order",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"serviceId\": \"507f1f77bcf86cd799439020\",\n  \"vendorId\": \"507f1f77bcf86cd799439011\",\n  \"items\": [\n    {\n      \"itemId\": \"shirt001\",\n      \"name\": \"Cotton Shirt\",\n      \"category\": \"Shirts\",\n      \"categoryId\": \"cat001\",\n      \"quantity\": 2,\n      \"weight\": 0.5\n    }\n  ],\n  \"pickupAddress\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"Accra\",\n    \"region\": \"Greater Accra\",\n    \"phone\": \"+233555000001\",\n    \"instructions\": \"Call when you arrive\"\n  },\n  \"deliveryAddress\": {\n    \"street\": \"456 Delivery Avenue\",\n    \"city\": \"Accra\",\n    \"region\": \"Greater Accra\",\n    \"phone\": \"+233555000002\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders",
							"host": ["{{base_url}}"],
							"path": ["orders"]
						},
						"description": "Create new order in draft status"
					},
					"response": [
						{
							"name": "Draft Order Created",
							"status": "Created",
							"code": 201,
							"body": "{\n  \"id\": \"ORD-1763652231465\",\n  \"orderNumber\": \"YRS231465\",\n  \"status\": \"draft\",\n  \"userId\": \"user123\",\n  \"serviceId\": \"507f1f77bcf86cd799439020\",\n  \"vendorId\": \"507f1f77bcf86cd799439011\",\n  \"totalWeight\": 1.0,\n  \"totalItems\": 2,\n  \"subtotal\": 20.00,\n  \"deliveryFee\": 8.00,\n  \"total\": 28.00,\n  \"currency\": \"GHS\",\n  \"createdAt\": \"2025-11-20T15:23:51.465Z\"\n}"
						}
					]
				},
				{
					"name": "Update Order",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vendorId\": \"507f1f77bcf86cd799439012\",\n  \"items\": [\n    {\n      \"itemId\": \"shirt001\",\n      \"name\": \"Cotton Shirt\",\n      \"category\": \"Shirts\",\n      \"categoryId\": \"cat001\",\n      \"quantity\": 3,\n      \"weight\": 0.5\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}"]
						},
						"description": "Update order details (only for draft orders)"
					},
					"response": [
						{
							"name": "Order Updated",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"id\": \"ORD-1763652231465\",\n  \"status\": \"draft\",\n  \"vendorId\": \"507f1f77bcf86cd799439012\",\n  \"subtotal\": 30.00,\n  \"deliveryFee\": 10.00,\n  \"total\": 40.00,\n  \"updatedAt\": \"2025-11-20T15:25:00.000Z\"\n}"
						}
					]
				},
				{
					"name": "Get Order Confirmation Details",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}/confirmation-details",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}", "confirmation-details"]
						},
						"description": "Get complete order details for confirmation screen"
					},
					"response": [
						{
							"name": "Confirmation Details",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"order\": {\n    \"id\": \"ORD-1763652231465\",\n    \"status\": \"draft\",\n    \"subtotal\": 20.00,\n    \"deliveryFee\": 8.00,\n    \"total\": 28.00\n  },\n  \"vendor\": {\n    \"id\": \"507f1f77bcf86cd799439011\",\n    \"name\": \"Quick Wash\",\n    \"rating\": 4.6,\n    \"deliveryFee\": 8.00\n  },\n  \"pricingBreakdown\": {\n    \"itemBreakdown\": [\n      {\n        \"itemId\": \"shirt001\",\n        \"basePrice\": 25.00,\n        \"vendorPrice\": 20.00,\n        \"savings\": 5.00\n      }\n    ]\n  },\n  \"canConfirm\": true,\n  \"isLocked\": false\n}"
						}
					]
				},
				{
					"name": "Confirm Order",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"confirmPricing\": true,\n  \"customerNotes\": \"Please handle with care\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}/confirm",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}", "confirm"]
						},
						"description": "Confirm order and lock pricing"
					},
					"response": [
						{
							"name": "Order Confirmed",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"id\": \"ORD-1763652231465\",\n  \"status\": \"confirmed\",\n  \"confirmedAt\": \"2025-11-20T15:30:00.000Z\",\n  \"lockedPricing\": {\n    \"vendorName\": \"Quick Wash\",\n    \"servicePrice\": 20.00,\n    \"total\": 28.00\n  },\n  \"message\": \"Order confirmed successfully!\",\n  \"nextSteps\": [\n    \"Vendor will contact you for pickup scheduling\",\n    \"Track your order status in the app\"\n  ]\n}"
						}
					]
				}
			]
		},
		{
			"name": "🛒 Checkout Flow",
			"item": [
				{
					"name": "Get Checkout Details",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"url": {
							"raw": "{{base_url}}/orders/{{order_id}}/checkout",
							"host": ["{{base_url}}"],
							"path": ["orders", "{{order_id}}", "checkout"]
						},
						"description": "Get checkout options with delivery and payment methods"
					},
					"response": [
						{
							"name": "Checkout Options",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"order\": {\n    \"id\": \"ORD-1763652231465\",\n    \"subtotal\": 20.00,\n    \"deliveryFee\": 8.00,\n    \"total\": 28.00\n  },\n  \"deliveryOptions\": [\n    {\n      \"type\": \"self_service\",\n      \"name\": \"Self Service\",\n      \"fee\": 0,\n      \"estimatedTime\": \"2-3 hours\"\n    },\n    {\n      \"type\": \"delivery_service\",\n      \"name\": \"Delivery Service\",\n      \"fee\": 8.00,\n      \"estimatedTime\": \"30-45 minutes\"\n    }\n  ],\n  \"paymentMethods\": [\n    {\n      \"id\": \"mtn_001\",\n      \"type\": \"mtn_mobile_money\",\n      \"displayName\": \"MTN Mobile Money\",\n      \"details\": \"+233**006\",\n      \"isDefault\": true\n    }\n  ]\n}"
						}
					]
				},
				{
					"name": "Process Checkout",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{auth_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": \"ORD-1763652231465\",\n  \"checkoutOptions\": {\n    \"deliveryType\": \"delivery_service\",\n    \"paymentMethod\": \"mtn_mobile_money\",\n    \"paymentDetails\": \"+233555000006\"\n  },\n  \"customerNotes\": \"Please call before pickup\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders/checkout",
							"host": ["{{base_url}}"],
							"path": ["orders", "checkout"]
						},
						"description": "Process checkout with delivery and payment selection"
					},
					"response": [
						{
							"name": "Checkout Success",
							"status": "OK",
							"code": 200,
							"body": "{\n  \"orderId\": \"ORD-1763652231465\",\n  \"orderNumber\": \"YRS231465\",\n  \"status\": \"pending_payment\",\n  \"totalAmount\": 28.00,\n  \"currency\": \"GHS\",\n  \"paymentMethod\": \"mtn_mobile_money\",\n  \"deliveryType\": \"delivery_service\",\n  \"paymentUrl\": \"https://payment-gateway.com/pay/1763652231465\",\n  \"paymentReference\": \"PAY_1763652231465\",\n  \"message\": \"Order placed successfully with delivery service. Please complete payment to confirm your order.\",\n  \"nextSteps\": [\n    \"Complete payment using the provided link\",\n    \"Track your order in the app\",\n    \"Vendor will contact you for pickup scheduling\"\n  ]\n}"
						}
					]
				}
			]
		}
	],
