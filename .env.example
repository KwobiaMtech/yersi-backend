# Application
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/laundry-service

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=30d

# Wasabi Storage
WASABI_REGION=us-east-1
WASABI_BUCKET=yersi-uploads
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
WASABI_ACCESS_KEY_ID=your_wasabi_access_key_id
WASABI_SECRET_ACCESS_KEY=your_wasabi_secret_access_key

# Payment Provider
PAYMENT_PROVIDER=seevcash
SEEVCASH_API_KEY=your_seevcash_api_key
SEEVCASH_BASE_URL=https://api-dev.seevcash.com/api/v1

# Google Maps (for location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
